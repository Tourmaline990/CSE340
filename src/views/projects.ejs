<%- include('partials/header') %>
    <main>
        <h1><%= title%></h1>
  

    <ul>
    <% projects.forEach(project => { %>
      <li>
       <strong> <a href="/project/<%= project.project_id%>"><%= project.title%></a></strong>
         <p><%= project.description%></p> 
        <strong> <a href="/organization/<%= project.organization_id%>"><%= project.name%></a></strong>
          <p><%= new Date(project.project_date).toDateString()%></p>  
    </li>
  <%  })%>
</ul>
 <% if(user && user.role_name === 'admin'){ %>
  <a href="/new-project" class="cta">Create a new service project</a>
 <% }%>
    </main>
<%- include('partials/footer')%>

