<%- include('partials/header') %>
    <main>
        <h1><%= title%></h1>
        <h2>Upcoming Service Projects</h2>

    <ul>
    <% projects.forEach(project => { %>
      <li>
        <a href="/project/<%= project.project_id%>"><%= project.title%></a>
         <p><%= project.description%></p> 
         <a href="/organization/<%= project.organization_id%>"><%= project.name%></a>
          <p><%= new Date(project.project_date).toDateString()%></p>  
    </li>
  <%  })%>
</ul>
    </main>
<%- include('partials/footer')%>

