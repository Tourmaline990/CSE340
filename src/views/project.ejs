<%- include('partials/header')%>
<main>
    <% projectDetails.forEach(detail => { %>
        <h1><%= detail.title %></h1>
        <p><%= detail.description %></p>
        <p><%= new Date(detail.project_date).toDateString() %></p>
        <p><%= detail.location %></p>
        <a href="/organization/<%= detail.organization_id %>"><%= detail.name %></a>
    
    <% }); %>
    <ul>
        <% projectCategoryTags.forEach(category => { %>
            <li class="group"><a href="/category/<%= category.category_id%>"><%= category.category_name%></a></li>
        <% })%>
    </ul>
    <% if(isLoggedIn && !volunteer.some(v => v.projectId === projectDetails[0].project_id)){ %>
        <form action="/volunteer/<%= projectDetails[0].project_id%>" method="POST">
            <button type="submit" class="cta">Volunteer</button>
        </form>
   <% }%>
   <% if(isLoggedIn && volunteer.some(v => v.projectId === projectDetails[0].project_id)){ %>
        <form action="/unvolunteer/<%= projectDetails[0].project_id%>" method="POST">
            <p>You have volunteered for this project.</p>
            <button type="submit" class="cta">Unvolunteer</button>
        </form>
    <% }%>
    <% if(user && user.role_name === "admin"){ %>
        <div class="button-container">
        <a href="/assign-categories/<%= projectDetails[0].project_id%>" class="cta">Edit categories</a>
        <a href="/edit-project/<%= projectDetails[0].project_id%>" class="cta">Edit Project Information</a>
       </div> 
     <% }%>
    
</main>
<%- include('partials/footer')%>