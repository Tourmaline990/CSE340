<%- include('partials/header')%>
    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
<ul>
    <% organizations.forEach(organization => { %>
       <li>
        <img src="/images/<%= organization.logo_filename%>" alt="<%= organization.name%> logo">
        <a href="/organization/<%= organization.organization_id %>">
           <strong><%= organization.name%></strong><strong><%= organization.contact_email%></strong>
        </a>
      </li>
   <% })%>
</ul>
  <a href="/new-organization" class="cta">Add a new organization</a>
    </main>
<%- include('partials/footer')%>


 